      "fps": 6,
      "loop": true,
      "energy_pulse": true,
      "charge_orbs_float": true,
      "hum_low": true
    },
    "attack": {
      "sprite": "res://assets/sprites/enemies/enemy_kinetic_battery_attack.png",
      "frames": 10,
      "fps": 16,
      "loop": false,
      "sound": "sfx/kinetic_release.wav",
