      "loop": true,
      "eyes_opening": true,
      "surfaces_watch": true,
      "unblinking_gaze": true
    },
    "watch": {
      "sprite": "res://assets/sprites/enemies/enemy_the_abyssal_witness_watch.png",
      "frames": 6,
      "fps": 2,
      "loop": false,
      "sound": "sfx/witness_gaze.wav",
