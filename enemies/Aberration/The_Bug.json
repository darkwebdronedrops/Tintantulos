{
  "name": "The Bug",
  "faction": "Aberration",
  "tier": "Early",
  "floor_range": [3, 4],
  "hp": 22,
  "max_hp": 22,
  "attack": 5,
  "pattern": ["Special", "Special", "Melee"],
  "weight": "Uncommon",
  "mechanic": {
    "name": "Clutter Hand",
