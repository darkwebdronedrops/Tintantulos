      "error_messages": true,
      "error_card_add": "res://vfx/error_add.tscn",
      "swarm_effect": true
    },
    "sound": "sfx/bug_buzz.wav"
  },
  "animations": {
    "idle": {
      "sprite": "res://assets/sprites/enemies/enemy_the_bug_idle.png",
      "frames": 8,
      "fps": 6,
      "loop": true,
      "pixel_swarm": true,
      "glitch_particles": true,
      "error_text_float": true
    },
    "attack": {
      "sprite": "res://assets/sprites/enemies/enemy_the_bug_attack.png",
      "frames": 6,
      "fps": 12,
      "loop": false,
      "sound": "sfx/bug_strike.wav",
      "pixel_burst": true
    },
    "special": {
      "sprite": "res://assets/sprites/enemies/enemy_the_bug_special.png",
      "frames": 8,
      "fps": 8,
      "loop": false,
      "sound": "sfx/error_add.wav",
      "error_card_vfx": "res://vfx/error_add.tscn",
