        "duration": "floor",
        "card_remains_reversed": true,
        "must_play_backwards": true,
        "no_visual_indicator": false
      }
    },
    "visual_feedback": {
      "opening_consumes_causality": true,
      "space_between_cause_effect": true,
      "logic_reversal_vfx": "res://vfx/logic_devour.tscn",
      "inverted_colors": true
    },
    "sound": "sfx/mouth_devour.wav"
  },
  "animations": {
    "idle": {
      "sprite": "res://assets/sprites/enemies/enemy_the_mouth_of_where_idle.png",
      "frames": 10,
      "fps": 3,
      "loop": true,
      "mouth_form": true,
      "consumes_space": true,
      "causality_gap": true
    },
    "devour": {
      "sprite": "res://assets/sprites/enemies/enemy_the_mouth_of_where_devour.png",
      "frames": 12,
      "fps": 8,
      "loop": false,
